<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TubeClean" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">#FF4DB6AC</item>
    </style>

    <!-- Phones and tablets: keep the status bar (clock, battery) and navigation bar. -->
    <style name="Theme.TubeClean.Phone" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">#FF4DB6AC</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="StatCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:background">#FF1E1E1E</item>
        <item name="android:padding">16dp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <!-- Phone stats screen: the cards stack instead of sitting side by side. -->
    <style name="StatCard.Stacked">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_weight">0</item>
        <item name="android:layout_marginEnd">0dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textSize">17sp</item>
    </style>
</resources>
