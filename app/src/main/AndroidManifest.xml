<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The only permission: loading YouTube. No storage, location, microphone or analytics. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Matches other sideloaded TV apps that get a proper tile on Fire OS 5's launcher. App stores
         would hide the app from phones because of it, but sideloaded installs don't check it. -->
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".TubeCleanApp"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TubeClean"
        android:usesCleartextTraffic="false">

        <!-- Banner and icon repeated on the launcher entry: some TV launchers read the activity only. -->
        <activity
            android:name=".MainActivity"
            android:banner="@drawable/banner"
            android:icon="@mipmap/ic_launcher"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".StatsActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="false" />
    </application>
</manifest>
